# evalbench server configuration
EVALBENCH_HOST=0.0.0.0
EVALBENCH_PORT=8000

# PostgreSQL connection (required)
EVALBENCH_POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/evalbench

# Redis configuration (optional, for distributed jobs)
EVALBENCH_REDIS_URL=redis://localhost:6379/0
EVALBENCH_REDIS_ENABLED=false

# LLM API Keys (used when running evaluations)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# GEMINI_API_KEY=your-gemini-key
